<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DersUygulamalari.Hafta4.Form3_KelimeleriUzunlugaGoreSiralama"
        Title="Hafta 4 - Kelimeleri Uzunluğa Göre Sıralama">

  <StackPanel Margin="20"
              Spacing="20"
              Orientation="Horizontal">

    <StackPanel Spacing="10">
      <TextBox x:Name="textBox1" PlaceholderText="Sıralanacak cümle" Width="500" />

      <Button Click="Button1_Click" Width="500">
        Kelimeleri Sırala
      </Button>
    </StackPanel>

    <ListBox x:Name="listBox1" Width="500" />
  </StackPanel>
</Window>
