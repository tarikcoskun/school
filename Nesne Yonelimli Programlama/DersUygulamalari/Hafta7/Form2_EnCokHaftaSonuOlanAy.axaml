<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DersUygulamalari.Hafta7.Form2_EnCokHaftaSonuOlanAy"
        Title="Hafta 7 - En Çok Hafta Sonu Olan Ay">

  <StackPanel Margin="20"
              Spacing="20"
              Orientation="Horizontal">

    <StackPanel Spacing="10">
      <TextBox x:Name="textBox1" PlaceholderText="Yıl" Width="150" />

      <Button Click="Button1_Click" Width="150">
        Bul
      </Button>
    </StackPanel>

    <ListBox x:Name="listBox1" Width="150" />
  </StackPanel>
</Window>
