<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:controls="using:DersUygulamalari.Controls"
        x:Class="DersUygulamalari.Hafta6.Form1_RichTextBoxOzellikleri"
        Title="Hafta 6 - RichTextBox Özellikleri">

  <StackPanel Margin="20"
              Spacing="20"
              Orientation="Horizontal">

    <controls:RichTextBox x:Name="richTextBox1"
                          Width="500" Height="300" />

    <StackPanel Spacing="10">
      <TextBlock x:Name="label1" Width="500" />

      <Button Click="Button1_Click" Width="500">
        İşlem Yap
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
