<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HesapMakinesi.MainWindow"
        Title="Hesap Makinesi"
        Width="380" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <StackPanel Margin="15" Spacing="8">

    <TextBox x:Name="txtEkran"
             IsReadOnly="True"
             Text="0"
             FontSize="22"
             TextAlignment="Right" />

    <Grid ColumnDefinitions="*,*,*,*"
          RowDefinitions="80,80,80,80,80">

      <!-- Satır 0: C  ←  %  / -->
      <Button Grid.Row="0" Grid.Column="0" Content="C"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="0" Grid.Column="1" Content="&#x2190;" Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="0" Grid.Column="2" Content="%"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="0" Grid.Column="3" Content="/"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>

      <!-- Satır 1: 7  8  9  * -->
      <Button Grid.Row="1" Grid.Column="0" Content="7"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="1" Grid.Column="1" Content="8"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="1" Grid.Column="2" Content="9"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="1" Grid.Column="3" Content="*"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>

      <!-- Satır 2: 4  5  6  + -->
      <Button Grid.Row="2" Grid.Column="0" Content="4"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="2" Grid.Column="1" Content="5"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="2" Grid.Column="2" Content="6"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="2" Grid.Column="3" Content="+"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>

      <!-- Satır 3: 1  2  3  - -->
      <Button Grid.Row="3" Grid.Column="0" Content="1"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="3" Grid.Column="1" Content="2"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="3" Grid.Column="2" Content="3"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="3" Grid.Column="3" Content="-"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>

      <!-- Satır 4: ,  0  = (2 sütun genişliğinde) -->
      <Button Grid.Row="4" Grid.Column="0" Content=","  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="4" Grid.Column="1" Content="0"  Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>
      <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="=" Click="Buton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="20" Margin="4"/>

    </Grid>
  </StackPanel>
</Window>
