
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DersUygulamalari.MainWindow"
        Title="Ders Uygulamaları"
        Width="700"
        Height="600">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="Ders Uygulamaları"
                       FontSize="24"
                       FontWeight="Bold"/>

            <StackPanel x:Name="FormsPanel"
                        Spacing="8"/>
        </StackPanel>
    </ScrollViewer>
</Window>
