<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:local="using:DersUygulamalari.Hafta6"
        x:Class="DersUygulamalari.Hafta6.Form4"
        Title="Hafta 6">

  <StackPanel Margin="20" Spacing="20" Orientation="Horizontal" VerticalAlignment="Top">
    <StackPanel Spacing="20">
      <CalendarDatePicker x:Name="dateTimePicker1" Width="250">
        <CalendarDatePicker.TextConverter>
          <local:TarihFormatConverter Format="d MMMM yyyy dddd" Culture="tr-TR" />
        </CalendarDatePicker.TextConverter>
      </CalendarDatePicker>

      <TextBox x:Name="textBox1" Width="500" />

      <Button x:Name="button1" Click="Button1_Click" Width="500">
        Hesapla
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
