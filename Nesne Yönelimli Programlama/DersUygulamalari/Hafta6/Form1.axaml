<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:DersUygulamalari"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DersUygulamalari.Hafta6.Form1"
        Title="Hafta 6">

  <StackPanel Margin="20" Spacing="20" Orientation="Horizontal" VerticalAlignment="Top">
    <StackPanel Spacing="20">
      <TextBox x:Name="textBox1" Width="500" />

      <Button x:Name="button1" Click="Button1_Click" Width="500">
        İşlem Yap
      </Button>

      <ListBox x:Name="listBox1" Width="500" MinHeight="200" />
    </StackPanel>

    <local:RichTextBox x:Name="richTextBox1" Width="500" Height="300" />
  </StackPanel>
</Window>
